\section{Arquitetura da ferramenta web}
\label{sec:web_arquitetura}

% ESCREVER (1.5 pagina): FastAPI + Next.js + 3 modelos persistidos.
% Endpoint /api/result retorna 3 scores + flag concordancia.
%
% Snippet de codigo (em ambiente lstlisting): mostrar combinar_scores()
% da API (8-10 linhas max).

\begin{lstlisting}[language=Python, basicstyle=\small\ttfamily, frame=single,
                   caption={Trecho da regra dual no \emph{backend} FastAPI.},
                   label={lst:dual_api}]
def _combinar_scores(score_textual, score_topo):
    pred_t = score_textual >= 0.5
    pred_k = score_topo    >= 0.5
    if pred_t == pred_k:
        return 0.5 * score_textual + 0.5 * score_topo, True
    return 0.8 * score_textual + 0.2 * score_topo,    False
\end{lstlisting}

