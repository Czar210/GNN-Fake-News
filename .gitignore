# ─────────────────────────────────────────────────────────────────────────
# DATASETS (todos baixados/gerados localmente -- ver README "Como obter os dados")
# ─────────────────────────────────────────────────────────────────────────

# Bluesky (~6 GB) -- ver README "dados_bluesky/" para fonte
dados_bluesky/
14669616.zip

# UPFD oficial -- ~2 GB (gossipcop) + ~315 MB (politifact)
# Baixado via PyG download_google_url ou manualmente do Drive (links no README)
Material/gossipcop/
Material/politifact/raw/
Material/politifact/processed/

# Mapeamentos UPFD legacy (pickles auxiliares)
Material/upfd_raw/*.pkl

# LIAR dataset (TSVs brutos pesados; mantém scripts e README)
Material/LIAR/src/*.tsv
Material/LIAR/src/*.html

# Visualizacoes HTML interativas (geradas; pesadas; ~3 MB cada conjunto)
Photos/*.html

# Versao compilada do TCC
GNN_TCC_atualizado.zip
# Material/GNN_TCC_atualizado/ -- removido para versionar fontes .tex no Git

# Embeddings BERT cacheados e grafos pre-construidos do FakeNewsNet
# Regenerados por 00_construir_grafos_fakenewsnet.py + gerar_folds.py
Training/03_Mega_Research/data/

# CSVs e parquets do pipeline antigo do Bluesky (legacy/desalinhado, ver README)
Training/01_BlueSky_Pipe/data/

# Pesos de modelos treinados (regenerados por 17_persistir_modelos_finais.py)
Execution/weights/*.pth
Execution/weights/*.pkl

# Resultados experimentais (regerados pelos scripts da fase 2-4)
# Mantemos apenas .tex (tabelas LaTeX) e relatorio.txt versionados
Execution/results/**/*.png
Execution/results/**/*.html
Execution/results/**/*.csv
